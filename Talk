#!/bin/bash
set -u

# Hier deinen echten Groq API-Key eintragen!
API_KEY="DEIN_API_KEY_HIER"

if [ -z "$API_KEY" ] || [ "$API_KEY" = "DEIN_API_KEY_HIER" ]; then
    notify-send "❌ Fehler" "API_KEY im Skript nicht gesetzt"
    exit 1
fi

for cmd in rec curl jq; do
    command -v "$cmd" >/dev/null || { notify-send "❌ Fehler" "$cmd fehlt"; exit 1; }
done

AUDIO=$(mktemp /tmp/diktat.XXXXXX.wav)
trap 'rm -f "$AUDIO"' EXIT

notify-send -t 2000 "🎙️ Diktat läuft" "Spreche jetzt... (Stopp bei 2 Sek. Stille)"

# max. 60 Sekunden Aufnahme
rec -q -c 1 -r 16000 "$AUDIO" silence 1 0.1 3% 1 2.0 3% trim 0 60

if [ ! -s "$AUDIO" ]; then
    notify-send "❌ Fehler" "Keine Aufnahme"
    exit 1
fi

notify-send -t 2000 "⏳ Verarbeite..." "Text wird generiert..."

RESPONSE=$(curl -s --max-time 30 -X POST \
  https://api.groq.com/openai/v1/audio/transcriptions \
  -H "Authorization: Bearer $API_KEY" \
  -F file="@$AUDIO" \
  -F model="whisper-large-v3-turbo" \
  -F language="de")

TEXT=$(printf '%s' "$RESPONSE" | jq -r '.text // empty' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$TEXT" ]; then
    ERR=$(printf '%s' "$RESPONSE" | jq -r '.error.message // "Unbekannter Fehler"' 2>/dev/null)
    notify-send "❌ Transkription fehlgeschlagen" -- "$ERR"
    exit 1
fi

if command -v wl-copy >/dev/null; then
    printf '%s' "$TEXT" | wl-copy
elif command -v xclip >/dev/null; then
    printf '%s' "$TEXT" | xclip -selection clipboard
else
    notify-send "❌ Fehler" "Weder wl-copy noch xclip gefunden"
    exit 1
fi

notify-send -t 4000 "✅ Kopiert!" -- "$TEXT"
