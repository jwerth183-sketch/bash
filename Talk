#!/bin/bash
set -u

# Berechtigungen für Hintergrund-Start (z.B. für Shortcuts in Cinnamon/Mint/GNOME)
export DISPLAY=:0
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
export XAUTHORITY=$HOME/.Xauthority

# Hier den eigenen Groq API-Key eintragen
API_KEY="DEIN_API_KEY_HIER"

if [ -z "$API_KEY" ] || [ "$API_KEY" = "DEIN_API_KEY_HIER" ]; then
    # Signalton FEHLER (tiefer Ton)
    play -q -n synth 0.3 sine 200 vol 0.3 >/dev/null 2>&1
    exit 1
fi

AUDIO=$(mktemp /tmp/diktat.XXXXXX.wav)
trap 'rm -f "$AUDIO"' EXIT

# Signalton START (kurzer Piep)
play -q -n synth 0.1 sine 800 vol 0.3 >/dev/null 2>&1

# max. 60 Sekunden Aufnahme, Rauschtoleranz auf 10% eingestellt
rec -q -c 1 -r 16000 "$AUDIO" silence 1 0.1 10% 1 2.0 10% trim 0 60

if [ ! -s "$AUDIO" ]; then
    exit 1
fi

RESPONSE=$(curl -s --max-time 30 -X POST \
  https://api.groq.com/openai/v1/audio/transcriptions \
  -H "Authorization: Bearer $API_KEY" \
  -F file="@$AUDIO" \
  -F model="whisper-large-v3-turbo" \
  -F language="de")

TEXT=$(printf '%s' "$RESPONSE" | jq -r '.text // empty' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$TEXT" ]; then
    # Signalton FEHLER (tiefer Ton)
    play -q -n synth 0.3 sine 200 vol 0.3 >/dev/null 2>&1
    exit 1
fi

# Reparatur für die Zwischenablage (Wayland/X11 Check)
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && command -v wl-copy >/dev/null; then
    printf '%s' "$TEXT" | wl-copy
elif command -v xclip >/dev/null; then
    printf '%s' "$TEXT" | xclip -selection clipboard
else
    # Signalton FEHLER falls kein Kopier-Tool gefunden wird
    play -q -n synth 0.3 sine 200 vol 0.3 >/dev/null 2>&1
    exit 1
fi

# Signalton FERTIG (etwas höherer, doppelter Piep)
play -q -n synth 0.1 sine 1000 synth 0.1 sine 1200 vol 0.3 >/dev/null 2>&1
